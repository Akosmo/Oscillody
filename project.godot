; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Oscillody"
config/description="Audio Visualizer"
config/version="2.0.0"
config/tags=PackedStringArray("app")
run/main_scene="uid://bgh2vemoru38h"
config/auto_accept_quit=false
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
boot_splash/image="res://Images/Oscillody Logo BG.png"
config/icon="res://Images/Oscillody Logo (with color).png"
config/windows_native_icon="res://Images/Oscillody Icon.ico"
boot_splash/minimum_display_time=500

[audio]

buses/default_bus_layout="uid://c82sn7go5gcr7"
driver/enable_input=true

[autoload]

SettingsManager="*uid://drrev0hbiwml8"
WindowUtilities="*uid://bocv6duulp86s"
ElementManager="*uid://bnho77fgm8yog"
AudioManager="*uid://ben01m561drjh"
RealTimeAudioData="*uid://wx06fafgb57s"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/return_value_discarded=1
gdscript/warnings/missing_await=1

[display]

window/energy_saving/keep_screen_on=false

[editor]

movie_writer/mix_rate=44100
movie_writer/disable_vsync=true

