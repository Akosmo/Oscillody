; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Oscillody"
config/description="Audio Visualizer"
config/version="3.0.0"
config/tags=PackedStringArray("app")
run/main_scene="uid://bgh2vemoru38h"
config/auto_accept_quit=false
config/features=PackedStringArray("4.8", "Forward Plus")
run/max_fps=60
boot_splash/image="uid://18gyq6x0cf6t"
config/icon="uid://bx3taxkx80j5l"
config/windows_native_icon="res://New Images/Oscillody_Logo_(icon).ico"

[audio]

buses/default_bus_layout="uid://c82sn7go5gcr7"
driver/enable_input=true

[autoload]

FileManager="*uid://diseumiwfhg14"
CustomLogger="*uid://cx8x8sv26n33t"
SettingsManager="*uid://drrev0hbiwml8"
MovieWriterUtilities="*uid://ce4lte85bt7ig"
